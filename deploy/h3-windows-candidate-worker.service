[Unit]
Description=NAL Studio Windows H3 candidate worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nalstudio/local-ai/video-engine
EnvironmentFile=%h/.config/h3-video-engine/runtime.env
Environment=VIDEO_ENGINE_ROOT=/home/nalstudio/local-ai/video-engine
Environment=H3_WORKER_LANE=windows_candidate
ExecStart=/home/nalstudio/local-ai/video-engine/.venv/bin/python /home/nalstudio/local-ai/video-engine/h3_worker.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
