VLLM_MODEL="Qwen/Qwen3.8-27B"
VLLM_REVIEW_TEMPERATURE="1.0"
VLLM_REVIEW_TOP_P="0.95"
VLLM_REVIEW_TOP_K="20"
# Qwen3.8 exposes the enable_thinking toggle; this SGLang recipe reports no
# separate effort keyword, so leave reasoning_effort unset.
VLLM_REVIEW_REASONING_EFFORT=""
# The scenario-grounded scoring pass reviews the complete video and its context.
# Qwen thinking mode makes a single candidate take tens of minutes on DGX Spark
# without improving visual tokenization.
VLLM_REVIEW_ENABLE_THINKING="false"
VLLM_VIDEO_REVIEW_TWO_PASS="false"
VLLM_REVIEW_AUDIO_CAPABLE="false"
VLLM_REVIEW_USE_AUDIO_IN_VIDEO="false"
VLLM_REVIEW_VIDEO_PROXY_MODE="source"
VLLM_REVIEW_VIDEO_TRANSPORT="direct_source_mp4_base64"
VLLM_REVIEW_MAX_TOKENS="8000"
VLLM_REVIEW_TIMEOUT="7200"
